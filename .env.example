# Copia este archivo como .env (junto a package.json) y completa lo que necesites.
# El archivo .env no se sube a GitHub. En Render, estas mismas variables van en Environment.

# Base de datos PostgreSQL. Sin esta línea, los datos se guardan en backend/data.json
# DATABASE_URL=postgresql://usuario:clave@servidor/base?sslmode=require

# Contraseñas de los usuarios iniciales (admin y vendedor). Cámbialas por unas seguras.
ADMIN_PASSWORD=
VENDEDOR_PASSWORD=

# Token de apis.net.pe para la consulta de DNI
DNI_API_TOKEN=

# Desactiva WhatsApp (recomendado en Render)
# WHATSAPP_DESACTIVADO=1

# Límite de intentos de inicio de sesión (opcional)
# LOGIN_MAX_INTENTOS=5
# LOGIN_BLOQUEO_MINUTOS=5
